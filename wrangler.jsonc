{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fireplace-art-controller",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "durable_objects": { "bindings": [{ "name": "TV", "class_name": "TVController" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TVController"] }],
  "observability": { "enabled": false }
}
